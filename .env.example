# ===================================================================
# CONFIGURATION PUBLICATION AUTOMATIQUE RESEAUX SOCIAUX - PROJETBI
# ===================================================================
# Renommez ce fichier en ".env" pour activer l'automatisation.

# -------------------------------------------------------------------
# 1. FACEBOOK PAGE (Meta Graph API)
# -------------------------------------------------------------------
# L'ID numérique de votre Page Facebook (ex: 104829104928172)
# Visible dans : Page Facebook > Paramètres > À propos > ID de Page
FB_PAGE_ID=

# Jeton d'accès de Page permanent (Page Access Token)
# Obtenu sur : https://developers.facebook.com/tools/explorer/
# Permissions nécessaires : pages_manage_posts, pages_read_engagement
FB_PAGE_ACCESS_TOKEN=

# -------------------------------------------------------------------
# 2. TWITTER / X (API v2)
# -------------------------------------------------------------------
# Obtenu sur : https://developer.x.com/en/portal/dashboard
# Dans votre App > "Keys and Tokens"
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# -------------------------------------------------------------------
# 3. OPTIONS DU SITE
# -------------------------------------------------------------------
SITE_URL=https://projetbi.org
AUTO_PUBLISH_REVUE=true
